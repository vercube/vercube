{
  "name": "@vercube/testing",
  "version": "1.3.3",
  "description": "Testing utilities for Vercube framework",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercube/vercube.git",
    "directory": "packages/testing"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./auth": "./dist/Auth.mjs",
    "./telemetry": "./dist/Telemetry.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vercube",
    "testing",
    "test",
    "integration",
    "mock"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts --config-loader=unrun"
  },
  "dependencies": {
    "@vercube/core": "workspace:*",
    "@vercube/di": "workspace:*",
    "@vercube/logger": "workspace:*"
  },
  "peerDependencies": {
    "@vercube/auth": "workspace:^",
    "@vercube/telemetry": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@vercube/auth": {
      "optional": true
    },
    "@vercube/telemetry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vercube/telemetry": "workspace:*",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
