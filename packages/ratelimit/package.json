{
  "name": "@vercube/ratelimit",
  "version": "1.5.0",
  "description": "Rate limiting module for Vercube framework",
  "packageManager": "pnpm@12.14.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercube/vercube.git",
    "directory": "packages/ratelimit"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/Testing.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vercube",
    "rate-limit",
    "ratelimit",
    "throttle",
    "redis"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts --config-loader=unrun"
  },
  "dependencies": {
    "@vercube/core": "workspace:*",
    "@vercube/di": "workspace:*",
    "@vercube/logger": "workspace:*",
    "@vercube/storage": "workspace:*",
    "@vercube/telemetry": "workspace:*"
  },
  "peerDependencies": {
    "@vercube/testing": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@vercube/testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vercube/auth": "workspace:*",
    "@vercube/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
