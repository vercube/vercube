{
  "name": "@vercube/devtools",
  "version": "1.2.1",
  "description": "Zero-config, self-hosted developer tools for Vercube - DI graph, route explorer, request waterfalls, bootstrap profiler and audits",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercube/vercube.git",
    "directory": "packages/devtools"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "vercube",
    "devtools",
    "dependency-injection",
    "profiler",
    "inspector"
  ],
  "scripts": {
    "build": "pnpm run build:ui && tsdown --config ../../tsdown.config.ts --config-loader=unrun",
    "build:ui": "vite build --config ./ui/vite.config.ts",
    "dev:ui": "vite --config ./ui/vite.config.ts"
  },
  "dependencies": {
    "@vercube/core": "workspace:*",
    "@vercube/di": "workspace:*",
    "@vercube/logger": "workspace:*",
    "defu": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "vite": "catalog:",
    "vue": "3.5.41"
  },
  "publishConfig": {
    "access": "public"
  }
}
